{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SeedomVFX Update Protocol 1",
  "type": "object",
  "required": ["schema_version", "application", "platform", "version", "base_versions", "build_date", "notes", "package"],
  "properties": {
    "schema_version": {"const": 1},
    "application": {"const": "Seedom"},
    "platform": {"const": "windows-x64"},
    "version": {"$ref": "#/$defs/version"},
    "base_versions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/version"}},
    "build_date": {"type": "string", "format": "date"},
    "notes": {"type": "string"},
    "package": {
      "type": "object",
      "required": ["name", "url", "bytes", "sha256"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+\\.zip$"},
        "url": {"type": "string", "pattern": "^https://github\\.com/DingBuDoa/Seedom/releases/download/v"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 268435456},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "$defs": {"version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"}}
}
